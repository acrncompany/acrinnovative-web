{
  "name": "acr-innovative-backend",
  "version": "1.0.0",
  "private": true,
  "description": "ACR Innovative website: NestJS server-side rendered site + admin API",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "node scripts/prisma-env.js migrate deploy",
    "seed:content": "tsx prisma/seed/initial-content.ts",
    "seed:admin": "tsx prisma/seed/admin-user.ts",
    "seed:build-assets": "tsx scripts/build-seed-assets.ts",
    "admin:reset-password": "tsx src/cli/reset-admin-password.ts",
    "mail:ethereal": "tsx src/cli/ethereal-account.ts",
    "mail:test": "tsx src/cli/send-test-email.ts",
    "doctor": "tsx src/cli/doctor.ts",
    "backup": "node scripts/backup.js",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.7",
    "hbs": "4.3.1",
    "helmet": "8.3.0",
    "multer": "2.4.0",
    "nodemailer": "10.1.7",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sanitize-html": "2.18.0",
    "sharp": "0.35.5",
    "tsx": "4.23.15"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@types/compression": "1.8.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/hbs": "4.0.5",
    "@types/multer": "2.3.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/sanitize-html": "2.16.2",
    "typescript": "5.9.3"
  }
}
