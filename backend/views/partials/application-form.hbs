{{!-- Job / open application form. Works without JavaScript (normal post) and with it (public/js/forms.js sends it in the background).
      Parameters: jobId (empty = open application), consent (consent line, editable in the admin), button (button text). --}}
<form id="apply" class="uk-form uk-grid-small" data-uk-grid data-enhance method="post" action="/api/public/applications" enctype="multipart/form-data" data-sending="Sending…">
	<input type="hidden" name="jobId" value="{{jobId}}">
	<div class="uk-width-1-2@s">
		<input class="uk-input uk-border-rounded{{#if form.errors.name}} uk-form-danger{{/if}}" name="name" type="text" placeholder="Full name" aria-label="Full name" required maxlength="150" autocomplete="name" value="{{form.values.name}}">
		<span class="field-error" data-error-for="name" role="alert">{{form.errors.name}}</span>
	</div>
	<div class="uk-width-1-2@s">
		<input class="uk-input uk-border-rounded{{#if form.errors.email}} uk-form-danger{{/if}}" name="email" type="email" placeholder="Email address" aria-label="Email address" required maxlength="200" autocomplete="email" value="{{form.values.email}}">
		<span class="field-error" data-error-for="email" role="alert">{{form.errors.email}}</span>
	</div>
	<div class="uk-width-1-1">
		<input class="uk-input uk-border-rounded{{#if form.errors.phone}} uk-form-danger{{/if}}" name="phone" type="tel" placeholder="Phone number (optional)" aria-label="Phone number" maxlength="30" autocomplete="tel" value="{{form.values.phone}}">
		<span class="field-error" data-error-for="phone" role="alert">{{form.errors.phone}}</span>
	</div>
	<div class="uk-width-1-1">
		<textarea class="uk-textarea uk-border-rounded{{#if form.errors.message}} uk-form-danger{{/if}}" name="message" rows="4" placeholder="Tell us about yourself (optional)" aria-label="Message" maxlength="3000">{{form.values.message}}</textarea>
		<span class="field-error" data-error-for="message" role="alert">{{form.errors.message}}</span>
	</div>
	<div class="uk-width-1-1">
		<label class="uk-text-small uk-text-muted" for="cv">Your CV (PDF, DOC or DOCX, up to 5 MB)</label>
		<input class="uk-input uk-border-rounded{{#if form.errors.cv}} uk-form-danger{{/if}}" id="cv" name="cv" type="file" accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" required data-max-bytes="5242880">
		<span class="field-error" data-error-for="cv" role="alert">{{form.errors.cv}}</span>
	</div>
	<!-- honeypot: real visitors never see or fill this -->
	<div class="in-form-honeypot" aria-hidden="true"><label>Leave this empty <input type="text" name="website" tabindex="-1" autocomplete="off"></label></div>
	<div class="uk-width-1-1">
		<p class="uk-text-small uk-text-muted uk-margin-small-bottom in-consent">{{#if consent}}{{consent}}{{else}}We'll use your details and CV only to process your application and to contact you about it.{{/if}}</p>
		<div class="form-status" role="status" aria-live="polite" tabindex="-1"></div>
		<button class="uk-button uk-button-primary uk-border-rounded uk-align-right" type="submit">{{#if button}}{{button}}{{else}}Submit Application{{/if}}</button>
	</div>
</form>
<script src="/public/js/forms.js" defer></script>
