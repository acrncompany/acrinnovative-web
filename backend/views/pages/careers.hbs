<main>
	{{#if form.sent}}<div class="uk-container uk-margin-top">{{> form-banner successText=b.form_success}}</div>{{else if form.message}}<div class="uk-container uk-margin-top">{{> form-banner}}</div>{{/if}}
	<!-- section content begin -->
	<div class="uk-section">
		<div class="uk-container">

			<!-- Hero image -->
			{{#if b.hero_image}}
			<div class="uk-grid uk-margin-bottom" data-uk-grid>
				<div class="uk-width-1-1">
					<img class="uk-border-rounded uk-box-shadow-small uk-width-1-1" style="max-height:380px;object-fit:cover;" src="{{b.hero_image.src}}" alt="{{b.hero_image.alt}}" width="{{b.hero_image.width}}" height="{{b.hero_image.height}}">
				</div>
			</div>
			{{/if}}

			<div class="uk-grid uk-flex uk-flex-center uk-margin-medium-top">
				<div class="uk-width-3-4@m">
					<h1 class="uk-margin-remove-bottom">{{hl b.hero_title}}</h1>
					<p class="uk-text-lead uk-text-muted uk-margin-small-top">{{b.hero_lead}}</p>
					<p class="uk-text-muted">{{b.hero_p1}}</p>
					<div class="uk-grid-divider uk-child-width-1-1 uk-child-width-1-3@m uk-margin-medium-top uk-margin-bottom" data-uk-grid>
						{{#each perks}}
						<div>
							<div class="in-icon-wrap primary-color uk-margin-small-bottom">
								<i class="{{icon}} fa-lg"></i>
							</div>
							<h2 class="uk-h4">{{title}}</h2>
							<p>{{body}}</p>
						</div>
						{{/each}}
					</div>
				</div>
			</div>

		</div>
	</div>
	<!-- section content end -->

	<!-- section content begin -->
	<div class="uk-section in-content-3 in-offset-top-20">
		<div class="uk-container">
			<div class="uk-grid uk-flex uk-flex-center">
				<div class="uk-width-3-4@m">
					<h2 class="uk-text-center uk-margin-medium-bottom">{{b.apply_title}}</h2>
					<div class="uk-card uk-card-default uk-card-body uk-border-rounded uk-box-shadow-small">
						<div class="uk-grid uk-flex uk-flex-middle" data-uk-grid>
							<div class="uk-width-1-12@m uk-text-center">
								<div class="in-icon-wrap primary-color" style="margin:0 auto;">
									<i class="fas fa-envelope fa-lg"></i>
								</div>
							</div>
							<div class="uk-width-expand@m">
								<h3 class="uk-h4 uk-margin-remove-bottom">{{b.apply_heading}}</h3>
								<div class="uk-text-muted uk-margin-small-top">{{{b.apply_p1}}}</div>
								<div class="uk-text-muted uk-margin-remove-bottom">{{{b.apply_p2}}}</div>
								<p class="uk-text-small uk-text-muted uk-margin-small-top">{{b.apply_note}}</p>
							</div>
						</div>
					</div>

					<div class="uk-grid uk-child-width-1-3@m uk-margin-medium-top uk-grid-small" data-uk-grid>
						{{#each areas}}
						<div>
							<div class="uk-card uk-card-default uk-card-small uk-card-body uk-border-rounded uk-box-shadow-small uk-text-center">
								<div class="in-icon-wrap primary-color uk-margin-small-bottom" style="margin:0 auto 12px;">
									<i class="{{icon}}"></i>
								</div>
								<h3 class="uk-h5 uk-margin-remove-bottom">{{title}}</h3>
								<p class="uk-text-small uk-text-muted uk-margin-small-top">{{body}}</p>
							</div>
						</div>
						{{/each}}
					</div>

					{{#if jobs.length}}
					<h2 class="uk-text-center uk-margin-large-top uk-margin-medium-bottom">{{b.jobs_title}}</h2>
					<div class="uk-grid uk-grid-small uk-child-width-1-1" data-uk-grid>
						{{#each jobs}}
						<div>
							<div class="uk-card uk-card-default uk-card-body uk-card-small uk-border-rounded uk-box-shadow-small">
								<div class="uk-flex uk-flex-between uk-flex-middle uk-flex-wrap" style="gap:12px;">
									<div>
										<h3 class="uk-h5 uk-margin-remove"><a class="uk-link-reset" href="/careers/{{slug}}">{{title}}</a></h3>
										<p class="uk-text-small uk-text-muted uk-margin-remove">{{location}} · {{employmentType}}{{#if department}} · {{department}}{{/if}}</p>
									</div>
									<a href="/careers/{{slug}}" class="uk-button uk-button-default uk-button-small uk-border-rounded">View &amp; Apply</a>
								</div>
							</div>
						</div>
						{{/each}}
					</div>
					{{/if}}

					<h2 class="uk-text-center uk-margin-large-top uk-margin-medium-bottom">{{b.form_title}}</h2>
					{{> application-form jobId="" consent=b.consent_text button=b.form_button}}
				</div>
			</div>
		</div>
	</div>
	<!-- section content end -->
</main>
