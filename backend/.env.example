# =====================================================================================================
# Settings for the ACR website.   Copy this file to ".env" for local development (never commit .env).
# On Hostinger there is no .env file: enter each variable in the Node.js app's "Environment variables"
# screen instead (see DEPLOY.md). Lines starting with # are comments.
#
#   REQUIRED     must be set for the site to start
#   PRODUCTION   required on the live server
#   OPTIONAL     has a sensible default
# =====================================================================================================

# ---- Where these settings are read from ------------------------------------------------------------
# On the server, keep ALL the settings in one private file OUTSIDE the app folder (e.g. /home/<user>/acr-data/.env) and
# enter just two variables in the hosting panel:  NODE_ENV=production  and  ENV_FILE=/home/<user>/acr-data/.env
# (a variable set in the panel itself always wins over the file). Locally the file is simply backend/.env.
ENV_FILE=

# ---- The site -------------------------------------------------------------------------------------
# PRODUCTION: "production" turns on secure login cookies, HTTPS-only behaviour and strict folder checks.
NODE_ENV=production

# OPTIONAL: the port the app listens on. Hosting panels usually provide it themselves; leave empty unless told otherwise.
PORT=

# REQUIRED: the public address of the site, exactly as visitors type it. No slash at the end. Used for
# canonical links, the sitemap, social previews, emails and the secure login cookie. Must be https:// on the server.
SITE_URL=https://acrinnovative.com

# OPTIONAL: set to true on a TEST address (before the real domain points to the new site) so Google ignores it.
# REMOVE this line when you go live.
NOINDEX_SITE=

# OPTIONAL: 1 = the hosting provider's proxy sits in front of the app (true on Hostinger), so visitor IP addresses
# (rate limits) are read correctly. Use 0 when running without a proxy.
TRUST_PROXY=1

# ---- Database (MySQL) -----------------------------------------------------------------------------
# REQUIRED. Format: mysql://USER:PASSWORD@HOST:3306/DATABASE_NAME
# On Hostinger the host is localhost and the user/database names start with "u123456789_".
# If the password contains special characters write them URL-encoded (@ = %40, # = %23, / = %2F, : = %3A, % = %25).
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/DBNAME"

# ---- Files: pictures and CVs ----------------------------------------------------------------------
# PRODUCTION: absolute paths to folders OUTSIDE the app folder (a redeploy replaces the app folder and would delete
# anything inside it). The two must be different folders. Locally they default to ../../acr-data/... next to the project.
# UPLOAD_DIR holds pictures uploaded in the admin (public, served at /uploads).
# PRIVATE_DIR holds CVs (private: never served; only the logged-in admin can download them).
UPLOAD_DIR=/home/USER/acr-data/uploads
PRIVATE_DIR=/home/USER/acr-data/private

# ---- Security -------------------------------------------------------------------------------------
# REQUIRED: a long random text (at least 32 characters in production) used to sign admin logins. Keep it secret.
# Create one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it logs everybody out.
JWT_SECRET=

# OPTIONAL: the admin login cookie is "Secure" (HTTPS only) automatically when NODE_ENV=production.
# For testing HTTPS on your own computer set COOKIE_SECURE=true.
COOKIE_SECURE=

# ---- First admin user -----------------------------------------------------------------------------
# Only read by "npm run seed:admin" which creates the FIRST admin if none exists. At least 10 characters.
# After that command has run, DELETE ADMIN_PASSWORD from the environment. Later password changes: in the admin
# (My account) or "npm run admin:reset-password".
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Email alerts ---------------------------------------------------------------------------------
# New contact messages and job applications are emailed to the address in Settings > Business details
# ("Send form alerts to"). If SMTP_HOST is empty nothing is emailed, but every submission is still saved
# and appears in the admin Inbox. Check your settings any time with:  npm run mail:test
#
# Option A: a Hostinger mailbox (hPanel > Emails: create one, use its FULL address as the user)
#   SMTP_HOST=smtp.hostinger.com   SMTP_PORT=465   SMTP_SECURE=true
#   SMTP_USER=info@yourdomain.com  SMTP_PASS=<the mailbox password>   SMTP_FROM=info@yourdomain.com
# Option B: Gmail with an App Password (Google account > Security > 2-Step Verification > App passwords)
#   SMTP_HOST=smtp.gmail.com       SMTP_PORT=465   SMTP_SECURE=true
#   SMTP_USER=yourname@gmail.com   SMTP_PASS=<16-character app password, NOT your normal password>   SMTP_FROM=yourname@gmail.com
# (Port 587 with SMTP_SECURE=false also works for both; it upgrades the connection with STARTTLS.)
# Option C: a FAKE mailbox for local testing, nothing is delivered to anyone:  npm run mail:ethereal -- --write
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# The sender shown in the inbox; must be the mailbox above (or allowed by it). Default: SMTP_USER.
SMTP_FROM=

# ---- Backups (used by "npm run backup") -----------------------------------------------------------
# OPTIONAL: where backup files are written. Default: a "backups" folder next to the uploads folder.
BACKUP_DIR=
# OPTIONAL: days to keep backups (default 14; the newest 3 are always kept).
BACKUP_KEEP_DAYS=14
# OPTIONAL: full path of the mysqldump program, only if the backup command cannot find it.
MYSQLDUMP_PATH=

# ---- Developer only -------------------------------------------------------------------------------
# OPTIONAL: read the starter pictures for "seed:content" from another folder (default: prisma/seed-assets).
SEED_ASSETS_DIR=
